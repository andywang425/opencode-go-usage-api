[Unit]
Description=OpenCode Go Usage API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/opt/opencode-go-usage-api
ExecStart=/opt/opencode-go-usage-api/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
