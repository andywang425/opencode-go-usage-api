# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 部署时务必：chmod 600 .env（内含等同账户登录态的 cookie）

# —— 抓取凭证 ——
# 你 OpenCode 账户的 auth cookie 值（登录后从浏览器开发者工具 Cookie 里复制）
AUTH_COOKIE=
# oc_locale cookie，影响返回文本语言
OC_LOCALE=zh

# —— 目标工作区 ——
# 你的工作区 ID（URL 里 /workspace/<这里>/go），必填
WORKSPACE_ID=wrk_XXX

# —— 访问鉴权 ——
# 第三方请求需带 Authorization: Bearer <这里>
# 建议生成一个强随机值，例如：openssl rand -hex 32
API_TOKEN=

# —— 抓取行为 ——
# 抓取超时时间（秒）
FETCH_TIMEOUT=10
# 抓取重试次数
FETCH_RETRIES=1
# 发起 HTTP 请求时使用的浏览器 UA
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36

# —— 响应 data 字段格式 ——
# 自定义 /usage 返回里 data 字段的格式（可选，留空用默认格式）。
# 可用占位符（{分组_字段}，标签文字自己写进模板）：
#   分组：rolling(滚动) / weekly(周) / monthly(月)
#   字段：percent(已用百分比数字) / reset(重置倒计时，如 3d16h) / status(状态)
# 例：{rolling_percent}、{weekly_reset}、{monthly_status}
# 缺失的项以 — 兜底；未知占位符原样保留；模板语法非法时自动回退默认格式。
# 默认格式：滚动 {rolling_percent}% ({rolling_reset}) | 周 {weekly_percent}% ({weekly_reset}) | 月 {monthly_percent}% ({monthly_reset})
DATA_TEMPLATE=
# —— HTTPS / 监听 ——
# 监听端口
PORT=18443
# 监听地址；0.0.0.0 表示对外
HOST=0.0.0.0
# TLS 证书路径（可选，可用 gen-cert.sh 生成自签证书，见 README）
SSL_CERTFILE=
SSL_KEYFILE=
